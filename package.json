{
  "name": "universal-document-reader-mcp",
  "version": "3.1.0",
  "private": true,
  "description": "Secure, per-job child-process isolated, token-efficient MCP server for PDF, DOCX, XLSX and CSV documents — baca, tulis, dan konversi",
  "license": "MIT",
  "author": "Maxodus126",
  "repository": {
    "type": "git",
    "url": "https://github.com/Maxodus126/MCP-FOR-DOCUMENT.git"
  },
  "keywords": [
    "mcp",
    "document",
    "pdf",
    "docx",
    "xlsx",
    "csv",
    "converter",
    "claude",
    "cursor"
  ],
  "type": "module",
  "engines": {
    "node": ">=20.19.0",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start:prod": "node dist/index.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node --import tsx --test test/*.test.ts",
    "doctor": "node scripts/doctor.mjs",
    "smoke": "node scripts/smoke-test.mjs",
    "check": "npm run typecheck && npm test && npm run build",
    "verify": "npm run check && npm run doctor && npm run smoke"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.25.2",
    "docx": "9.15.2",
    "dotenv": "16.6.1",
    "exceljs": "4.4.0",
    "mammoth": "1.10.0",
    "pdf-parse": "2.4.5",
    "pdfkit": "0.20.2",
    "turndown": "7.2.0",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/node": "22.19.0",
    "@types/pdfkit": "0.17.7",
    "@types/turndown": "5.0.5",
    "tsx": "4.20.6",
    "typescript": "5.9.3"
  }
}
