# WAJIB: absolute path. Hanya file di folder ini dan subfoldernya yang dapat dibaca.
# Windows: gunakan titik koma. Contoh: C:/Users/Anda/Documents;D:/Shared/Reports
# Linux/macOS: gunakan titik dua. Contoh: /home/anda/Documents:/mnt/shared/reports
ALLOWED_DIRS=C:/Users/YOUR_USER/Documents

# Wajib untuk tool penulisan (create_*, convert_document). Default = ALLOWED_DIRS.
# Hanya di sini file output boleh ditulis. Windows: pisah dengan titik koma.
ALLOWED_OUTPUT_DIRS=C:/Users/YOUR_USER/Documents/Output

# File maksimum tetap dibatasi keras sampai 50 MB.
MAX_FILE_SIZE_MB=50

# Output tool. Default 100.000 karakter; batas konfigurasi maksimum 250.000.
MAX_OUTPUT_CHARS=100000

# Batas input teks/Markdown untuk create_pdf / create_docx / convert. Default 100.000; maks 250.000.
MAX_INPUT_CHARS=100000

# Resource protection. Setiap parser berjalan dalam child process; concurrency lebih tinggi memakai RAM lebih besar.
MAX_CONCURRENT_TOOLS=1
MAX_QUEUED_TOOLS=16
MAX_QUEUE_WAIT_MS=30000
MAX_PROCESSING_TIMEOUT_MS=60000
WORKER_OLD_SPACE_MB=384
WORKER_SEMI_SPACE_MB=16

# Batas dekompresi aktual arsip DOCX/XLSX dan kompleksitas ZIP.
MAX_ZIP_EXPANDED_MB=100
MAX_ZIP_ENTRIES=2000
MAX_ZIP_COMPRESSION_RATIO=100

# Batas scanning Excel dan ekstraksi PDF.
MAX_EXCEL_SCAN_ROWS=20000
MAX_EXCEL_SCAN_COLUMNS=50
MAX_PDF_PAGES=1000
